# 기본값은 AWS를 호출하지 않는 사전 기반 추출입니다.
USE_BEDROCK=false
AWS_REGION=ap-northeast-2
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
# AWS 자격 증명은 이 파일에 쓰지 말고 `aws login` 또는 ~/.aws 프로필을 사용하세요.

# Techmap Jobs API (RapidAPI). 키는 RapidAPI → Console → 앱 → Authorization 또는 API 화면 Headers 탭의 X-RapidAPI-Key 값.
TECHMAP_RAPIDAPI_KEY=
# 무료 월 100회, 초과 1회당 $0.06. 수집기는 이 횟수를 넘으면 호출하지 않는다.
TECHMAP_MONTHLY_REQUEST_CAP=80
